{
  "name": "cf-timer",
  "version": "0.2.0-dev.0",
  "private": true,
  "description": "CF Timer — local-first workout timer",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "spec": "npm --prefix tooling/openspec run openspec --",
    "spec:list": "npm --prefix tooling/openspec run openspec -- list",
    "spec:validate": "npm --prefix tooling/openspec run validate",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run build:relay",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:relay": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "dev:qr": "node --env-file-if-exists=.env tools/dev-remote.mjs",
    "test:remote": "vitest run src/application src/protocol src/remote src/server",
    "build:relay": "node tools/build-relay.mjs",
    "start:relay": "node --env-file-if-exists=.env dist-relay/main.js",
    "preview:qr": "node --env-file-if-exists=.env tools/dev-remote.mjs --preview"
  },
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
